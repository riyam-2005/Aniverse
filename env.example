# Local SQLite database (default, works with zero setup)
DATABASE_URL="file:./dev.db"

# Generate one with: openssl rand -base64 32 (must be 32+ characters — checked at startup)
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional — only needed if you want "Sign in with Google" too.
# Leave blank to keep email/password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — only needed for rate limiting that's exact across multiple
# serverless instances (e.g. Vercel). Leave blank to use the in-memory
# fallback, which is fine for single-instance hosts and local dev.
# Get these from https://upstash.com (free tier).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — only needed to actually email password-reset links. Get a key
# from https://resend.com (free tier). Without it, reset links are printed
# to the server console instead, which is fine for local dev only.
RESEND_API_KEY=""
MAIL_FROM="AniVerse <onboarding@resend.dev>"

# Optional but recommended in production — protects the /api/cron/*
# routes so only Vercel's own Cron Jobs can trigger them. Generate one with:
# openssl rand -base64 32
# Vercel sends this automatically once you add the same value in your
# project's Environment Variables settings — no extra config needed beyond that.
CRON_SECRET=""

# Optional — only needed to enable the "I'm not a robot" checkbox on
# registration. Get free keys from https://www.google.com/recaptcha/admin
# (choose reCAPTCHA v2 "Checkbox"). Leave both blank to skip captcha checks
# entirely (fine for local dev).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Optional — only needed for phone number sign-in/verification, via
# Firebase Phone Authentication (NOT Twilio, NOT a generic SMS gateway —
# see src/lib/firebaseAdmin.ts for setup steps and the free-tier caveat).
# Leave all six blank to disable phone sign-in entirely (email/password and
# Google still work).
#
# Client-side config (safe to expose to the browser) — from Firebase
# project settings > General > Your apps > SDK setup and configuration:
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
#
# Server-side config (keep secret) — from a service account key generated
# at Firebase project settings > Service accounts > Generate new private
# key. The private key contains real newlines; paste it as literal \n
# sequences (the app un-escapes them at startup).
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Optional — comma-separated emails allowed to view /admin (the analytics
# and monitoring dashboards), used as a bootstrap mechanism before any user
# has the ADMIN role in the database. Once at least one admin exists via
# the DB (see README), this can be left blank — it's an OR, not a
# replacement for the DB role.
ADMIN_EMAILS=""
