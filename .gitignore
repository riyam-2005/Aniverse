*.db
*.db-journal
prisma/dev.db
prisma/e2e-test.db

# Generated Postgres schema (derived from schema.prisma — see
# scripts/generate-postgres-schema.mjs)
prisma/schema.postgres.prisma

# Test/build artifacts
coverage/
playwright-report/
test-results/
/blob-report/

# Editor/OS
.DS_Store
*.pem
.vscode/
.idea/

# Vercel
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
