{
  "name": "aniverse",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "analyze": "cross-env ANALYZE=true npm run build",
    "build:postgres": "node scripts/generate-postgres-schema.mjs && prisma generate --schema=prisma/schema.postgres.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:push:postgres": "node scripts/generate-postgres-schema.mjs && prisma db push --schema=prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "cross-env DATABASE_URL=file:./e2e-test.db prisma db push --skip-generate --force-reset",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:test:postgres:up": "docker compose -f docker-compose.test.yml up -d && node scripts/wait-for-postgres.mjs",
    "db:test:postgres:migrate": "node scripts/generate-postgres-schema.mjs && cross-env DATABASE_URL=postgresql://aniverse:aniverse@localhost:55432/aniverse_test prisma db push --schema=prisma/schema.postgres.prisma",
    "db:test:postgres:verify": "cross-env DATABASE_URL=postgresql://aniverse:aniverse@localhost:55432/aniverse_test node scripts/verify-postgres.mjs",
    "db:test:postgres:down": "docker compose -f docker-compose.test.yml down -v",
    "db:test:postgres": "npm run db:test:postgres:up && npm run db:test:postgres:migrate && npm run db:test:postgres:verify && npm run db:test:postgres:down"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "bcryptjs": "^2.4.3",
    "firebase": "^10.13.0",
    "firebase-admin": "^12.4.0",
    "framer-motion": "^11.3.19",
    "next": "14.2.15",
    "next-auth": "^4.24.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@next/bundle-analyzer": "^14.2.15",
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "pg": "^8.13.0",
    "postcss": "^8.4.45",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
